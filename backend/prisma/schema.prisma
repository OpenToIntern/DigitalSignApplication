datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  googleEmail String?    @unique
  name        String
  nik         String?
  accessRole  String     // 'user', 'supervisor', 'manager'
  nikVerified Boolean    @default(false)
  documents   Document[] @relation("SenderRelation")
  markers     Marker[]   @relation("AssignedRelation")
  signatories DocumentSignatory[]
  auditLogs   AuditLog[]
  notifications Notification[]
  passwordHash         String?
  publicCertificate    String?
  encryptedPrivateKey  String?
}

model Document {
  id           String     @id
  name         String
  category     String
  size         String
  status       String     // 'draft', 'pending_supervisor', 'pending_manager', 'locked', 'rejected'
  senderId     String
  sender       User       @relation("SenderRelation", fields: [senderId], references: [id])
  fileKey      String     // MinIO object key
  signedFileKey  String?   // MinIO object key for signed version
  signedFileHash String?   // SHA-256 hash of the signed PDF (set at lock time for fast verification lookup)
  uploadedAt   DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  baselineHash String
  pageCount    Int        @default(1)
  markers      Marker[]
  signatories  DocumentSignatory[]
  auditLogs    AuditLog[]
  notifications Notification[]
  rejectionComment String?
}

model DocumentSignatory {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  order      Int

  @@unique([documentId, userId])
  @@index([documentId, order])
}

model Marker {
  id           String    @id
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  x            Float
  y            Float
  width        Float
  height       Float
  page         Int
  type         String    // 'signature', 'date', 'text'
  assignedToId String
  assignedTo   User      @relation("AssignedRelation", fields: [assignedToId], references: [id])
  signed       Boolean   @default(false)
  signedAt     DateTime?
  signature    String?   // DataURL of the signature image
  metadata     Json?     // Cryptographic verification logs/details
}

model AuditLog {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  event      String   // e.g. DOCUMENT_CREATED, SIGNATURE_MARKERS_PLACED, etc.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  timestamp  DateTime @default(now())
  ip         String
  metadata   Json?
}

model MockDukcapilRecord {
  id          String   @id @default(uuid())
  nik         String   @unique
  fullName    String
  dateOfBirth String
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type       String   // "invited_to_sign" | "co_signatory_completed" | "document_locked"
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

